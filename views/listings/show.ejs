<% layout('/layouts/boilerplate') -%>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>"
    const lngLat = <%- JSON.stringify(listing.geometry.coordinates) %>;
</script>
<!-- -----------------------Listing information------------------------------------- -->
<div class="row">
    <div class="col-8 offset-3">
        <br>
        <h3 class="card-title"><%=listing.title%></h3>
        <br>
    </div>
    <div class="card listing-card col-6 offset-3">
        <img src="<%=listing.image.url%>" class="card-img-top" alt="listing-image">
    
        <div class="card-body">
            <p class="card-text">
                <%=listing.description%> <br>
                <b>Price:</b> &#x20B9 <%=listing.price.toLocaleString("en-IN")%> /night <br>
                <b>Located at:</b> <%=listing.location%> <br>
                <b>Country:</b> <%=listing.country%> <br>
                <b>Owned by:</b> <i> <%=listing.owner.username%></i>
            </p>
        </div>      
    </div>  
</div>
<% if(currUser && currUser._id.equals(listing.owner._id)){ %>
    <div class="btns">
        <button class="btn btn-dark offset-3"><a href="/listings/<%=listing._id%>/edit">Edit</a></button>
        <form action="/listings/<%=listing._id%>?_method=DELETE" method="post">
            <button class="btn btn-dark offset-3">Delete</button>
        </form>
    </div>
    <br>
    <% } %>
    <!-- -----------------------Review Form------------------------------------- -->
    <div class="row">
        <% if(currUser) {%>
            <div class="col-6 offset-3">
                <hr>
                <h4>Leave a review</h4>
                <form action="/listings/<%=listing._id%>/reviews" method="post" novalidate class="needs-validation">
                    <div>
                        <label for="rating" class="form-label">Rating</label>
                        <!-- <input type="range" min="1" max="5" name="review[rating]" id="rating" class="form-range"> -->
                    </div>
                    <fieldset class="starability-basic">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                    <div class>
                        <label for="comment" class="form-label">Comments</label>
                        <textarea name="review[comment]" id="comment" class="form-control" required></textarea>
                        <div class="invalid-feedback">This field is required!</div>
                    </div>
                    <br>
                    <button class="btn btn-dark">Submit</button>
                </form>
            </div>
        <% } %>
    <br> <br>
<!-- -----------------------------Show All Reviews------------------------------------- -->
    <% if(listing.reviews.length > 0){ %>
    <div class="col-6 offset-3 row mt-4">
        <hr>
        <h4>All reviews</h4>
        <% for(review of listing.reviews){%>
            <div class="card mb-2">
                <div class="card-body">
                    <h5 class="card-title">@<%=review.author.username%></h5>
                    <p class="starability-result" data-rating="<%=review.rating%>"></p>
                    <p class="card-text"><%=review.comment%></p>
                    <% if(currUser && currUser._id.equals(review.author._id)){ %>
                    <form action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" method="post"> 
                        <button class="btn btn-dark btn-sm">Delete</button>
                    </form>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>
    <% } %>
<!-- -------------------------Show map---------------------------- -->
    <div class="col-6 offset-3 row mt-4">
        <hr>
        <h4>Where you'll be</h4>
        <div id="map" class="card-img-top"></div>
        
    </div>
</div>
<br><br>
<script src="/js/map.js"></script>



<!-- </html> -->